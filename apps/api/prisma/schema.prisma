generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                   String                 @id @default(uuid())
  name                 String
  createdAt            DateTime               @default(now())
  audiences            Audience[]
  seller               Seller[]
  contacts             Contact[]
  campaigns            Campaign[]
  messages             CampaignMessage[]
  chatwootConversation ChatwootConversation[]
  numbers              SenderNumber[]
  templates            Template[]
  users                User[]
  webHooks             WebhookEvent[]
  MetaConnection       MetaConnection[]
  ChatwootConnection   ChatwootConnection[]
}

model User {
  id          String     @id @default(uuid())
  name        String
  email       String     @unique
  password    String
  workspaceId String
  campaigns   Campaign[]
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
}

model Template {
  id             String         @id @default(uuid())
  workspaceId     String

  name           String
  body           String
  channel        Channel
  category       TemplateCategory
  language       String

  variables      Json?
  status         TemplateStatus @default(PENDING)
  metaTemplateId String?

  createdAt      DateTime @default(now())

  campaigns      Campaign[]
  workspace      Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, metaTemplateId])
}

model Contact {
  id                String   @id @default(uuid())
  workspaceId       String

  name              String?
  phoneRaw          String
  phoneNormalized   String
  email             String?

  hasWhatsapp       Boolean  @default(true)
  isBlocked         Boolean  @default(false)

  chatwootContactId String?
  chatwootSourceId  String?

  createdAt         DateTime @default(now())

  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  audiences         AudienceContact[]
  messages          CampaignMessage[]
  chatwootMessage   ChatwootConversation[]

  @@unique([workspaceId, phoneNormalized])
  @@index([phoneNormalized])
  @@index([workspaceId])
}

model Audience {
  id            String            @id @default(uuid())
  workspaceId   String

  name          String
  totalContacts Int               @default(0)
  createdAt     DateTime          @default(now())

  workspace     Workspace         @relation(fields: [workspaceId], references: [id])
  contacts      AudienceContact[]
  campaigns     Campaign[]

  @@index([workspaceId])
}

model AudienceContact {
  id          String   @id @default(uuid())

  audienceId  String
  contactId   String
  sellerId    String?

  createdAt   DateTime @default(now())

  audience    Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  seller      Seller?  @relation(fields: [sellerId], references: [id])

  @@unique([audienceId, contactId])
  @@index([contactId])
  @@index([sellerId])
}

model Seller {
  id                String            @id @default(uuid())
  workspaceId       String
  name              String
  phoneRaw          String?
  phoneNormalized   String?


  chatwootAgentId   Int?
  chatwootAccountId Int?

  createdAt       DateTime          @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  audiences       AudienceContact[]


  @@unique([workspaceId, chatwootAgentId])
  @@index([phoneNormalized])

}

model Campaign {
  id                String            @id @default(uuid())
  workspaceId       String
  name              String
  userId            String
  templateId        String
  audienceId        String

  status            CampaignStatus    @default(DRAFT)
  scheduledAt       DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  totalContacts     Int?
  processedContacts Int?

  createdAt         DateTime          @default(now())

  audience          Audience          @relation(fields: [audienceId], references: [id])
  
  template          Template          @relation(fields: [templateId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  workspace         Workspace         @relation(fields: [workspaceId], references: [id])
  batches           CampaignBatch[]
  messages          CampaignMessage[]
  stats             CampaignStats?

  @@index([status])
  @@index([scheduledAt])
}

model CampaignMessage {
  id                     String            @id @default(uuid())
  campaignId             String
  contactId              String
  phoneNormalized        String
  batchId                String?
  senderNumberId         String?
  workspaceId            String

  status                 MessageStatus     @default(PENDING)
  error                  String?

  providerId             String?
  chatwootConversationId Int?
  chatwootInboxId        Int?

  lastEventType          MessageEventType?
  queuedAt               DateTime?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  readAt                 DateTime?
  lockedAt               DateTime?
  
  retryCount             Int               @default(0)
  createdAt              DateTime          @default(now())

  batch                  CampaignBatch?    @relation(fields: [batchId], references: [id])
  campaign               Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact                Contact           @relation(fields: [contactId], references: [id])
  senderNumber           SenderNumber?     @relation(fields: [senderNumberId], references: [id])
  workspace              Workspace         @relation(fields: [workspaceId], references: [id])
  events                 MessageEvent[]

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([status, retryCount])
  @@index([phoneNormalized])
  @@index([providerId])
  @@index([chatwootConversationId])
}

model CampaignBatch {
  id         String            @id @default(uuid())
  campaignId String

  batchIndex Int
  size       Int
  status     BatchStatus       @default(PENDING)

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt  DateTime          @default(now())

  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages   CampaignMessage[]

  @@index([campaignId])
}

model CampaignStats {
  id                String   @id @default(uuid())
  campaignId        String   @unique

  totalMessages     Int      @default(0)
  sentMessages      Int      @default(0)
  deliveredMessages Int      @default(0)
  readMessages      Int      @default(0)
  failedMessages    Int      @default(0)

  updatedAt         DateTime @updatedAt

  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model ChatwootConnection {
  id                String   @id @default(uuid())

  workspaceId       String   @unique
  baseUrl           String
  apiToken          String
  accountId         Int

  createdAt         DateTime @default(now())

  workspace         Workspace @relation(fields: [workspaceId], references: [id])
}

model ChatwootConversation {
  id                     String    @id @default(uuid())
  chatwootConversationId Int       @unique
  chatwootContactId      Int
  inboxId                Int
  workspaceId            String
  contactId              String?

  lastMessageAt          DateTime?

  createdAt              DateTime  @default(now())

  workspace              Workspace @relation(fields: [workspaceId], references: [id])
  contact                Contact? @relation(fields: [contactId], references: [id])

  @@index([chatwootContactId])
}

model MessageEvent {
  id              String           @id @default(uuid())
  messageId       String

  type            MessageEventType
  providerPayload Json?

  createdAt       DateTime         @default(now())

  message         CampaignMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([type])
}

model SenderNumber {
  id           String            @id @default(uuid())
  workspaceId  String
  number       String            @unique
  status       String
  qualityScore Float             @default(1.0)
  maxPerSecond Int               @default(20)
  lockedAt     DateTime?
  createdAt    DateTime          @default(now())
  messages     CampaignMessage[]

  workspace    Workspace         @relation(fields: [workspaceId], references: [id])
}

model WebhookEvent {
  id          String          @id @default(uuid())
  externalId  String?         @unique
  workspaceId String
  provider    WebhookProvider
  eventType   String
  payload     Json
  processed   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
}

model MetaConnection {
  id              String   @id @default(uuid())
  workspaceId     String   @unique

  accessToken     String
  businessId      String
  wabaId          String
  phoneNumberId   String
  phoneNumber     String?
  displayName     String?

  webhookToken    String?
  webhookUrl      String?

  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebhookProvider {
  META
  CHATWOOT
}

enum MessageEventType {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  REPLIED
}

enum Channel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  FINISHED
  FAILED
}

enum BatchStatus {
  PENDING
  RUNNING
  FINISHED
  FAILED
}

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  DELIVERED
  READ
}
